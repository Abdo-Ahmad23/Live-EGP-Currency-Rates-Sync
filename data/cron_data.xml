<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_sync_egp_currency_rates" model="ir.cron">
        <field name="name">ExchangeRate-API: Sync Live EGP Rates</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="state">code</field>
        <field name="code">model.action_sync_egp_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="time.strftime('%Y-%m-%d 06:00:00')"/>
    </record>
</odoo>
